# Service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=9000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pharma_chunks

# Embeddings (BGE-small produces 384-dim vectors)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# LLM (defaults: OpenRouter -> gpt-4o-mini)
# - Direct OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# - OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openai/gpt-4o-mini
# - Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b  LLM_API_KEY=ollama
# - Groq direct:    LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-70b-versatile
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Ingestion
DOCS_DIR=../docs
CHUNK_CHAR_SIZE=3200
CHUNK_CHAR_OVERLAP=400

# HuggingFace cache (keep model weights inside workspace, not ~/.cache)
HF_HOME=./data/hf-cache

# Debug retrieval endpoint (GET /debug/retrieve) — restart uvicorn after changing
APP_ENV=development
DEBUG_RETRIEVAL=true

# Chat routing (structured-first, LLM only when needed)
STRUCTURED_DIRECT_THRESHOLD=80
STRUCTURED_HYBRID_THRESHOLD=50
ENABLE_QUERY_EXPANSION=true
USE_LLM_ON_HYBRID=false
USE_LLM_ON_VECTOR_FALLBACK=false
MIN_VECTOR_SCORE=0.30

# BM25 + dense hybrid (RRF). Rebuild sparse index: python scripts/rebuild_bm25.py
ENABLE_BM25_HYBRID=true
BM25_FETCH_K=40
HYBRID_RRF_K=60

# Cross-encoder reranking (Phase 3 — pairs with BGE embed model)
ENABLE_CROSS_ENCODER_RERANK=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=40
RERANK_CE_WEIGHT=0.72
RERANK_VECTOR_WEIGHT=0.18
RERANK_HEURISTIC_WEIGHT=0.10
